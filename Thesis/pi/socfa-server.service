# SoCFA — share the captured flights over Wi-Fi (pi_server.py, port 8000) from boot,
# so app.py on the laptop can pick up new flights automatically after landing.
#
# Install (on the Pi, once):
#   1. Copy pi_server.py to /home/socfa/socfa/   (user "socfa")
#   2. sudo apt install python3-flask
#   3. sudo cp socfa-server.service /etc/systemd/system/
#   4. sudo systemctl daemon-reload && sudo systemctl enable --now socfa-server

[Unit]
Description=SoCFA capture server (shares flights with the laptop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=socfa
WorkingDirectory=/home/socfa/socfa
ExecStart=/usr/bin/python3 /home/socfa/socfa/pi_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
