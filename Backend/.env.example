# Environment Configuration Example
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Configuration (automatically loaded from firebase-key.json)
# No need to add here - service account key is read from firebase-key.json file

# Optional: Add CORS allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Optional: Database limits
MAX_SOIL_READINGS=1000
MAX_DRONE_ANALYSES=500

# Optional: NDVI Thresholds (can be customized)
NDVI_EXCELLENT=0.7
NDVI_GOOD=0.5
NDVI_FAIR=0.3
NDVI_POOR=0.1

# Optional: API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
